# mk-go - Application Environment Variables
# Copy this file to .env and adjust values for your environment.

# Frontend assets directory (built Misskey frontend)
MISSKEY_FRONTEND_DIR=built/_frontend_vite_

# Frontend dist assets directory (locales, fonts)
MISSKEY_FRONTEND_DIST_DIR=built/_frontend_dist_

# Twemoji SVG directory
MISSKEY_TWEMOJI_DIR=third_party/misskey/packages/backend/node_modules/@misskey-dev/emoji-assets/built/twemoji

# Fluent Emoji directory (achievement badges / notification icons)
MISSKEY_FLUENT_EMOJI_DIR=third_party/misskey/packages/backend/node_modules/@misskey-dev/emoji-assets/built/fluent-emoji

# Static assets directory (favicon, splash, icons etc.)
MISSKEY_STATIC_DIR=assets
