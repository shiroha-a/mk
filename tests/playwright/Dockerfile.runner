# Playwright runner image for #744 Phase 1.
#
# 公式 Playwright image は browser を内蔵しているが本 PR では API 中心
# spec のみ実行するので browser は使わない。それでも公式 image にしておく
# 理由は、後続 PR で page.goto ベース spec を追加するときに browser が
# 即座に使えるよう構成を固定しておきたいため。
#
# base image の version と package.json の @playwright/test は**必ず同じ値**に
# する。base image には対応 version の browser binary しか同梱されないため、
# ずれると `browserType.launch: Executable doesn't exist` で page 系 spec が
# 全滅する。
#
# 過去に caret レンジ (^1.59.1) + 固定 base image + lockfile 不在の 3 点が
# 揃っていたため、CI のコールドキャッシュで npm install が毎回最新を解決し、
# 1.59.1 → 1.62.1 まで漂流して nightly が 86 日間全滅した。現在は
# package.json を完全固定 + lockfile を commit + npm ci で再現性を担保する。
# version を上げるときは **この FROM と package.json を同一 PR で両方**変更する。
FROM mcr.microsoft.com/playwright:v1.62.1-jammy

# **apt を使わない。** 以前は rate limit counter の flush に redis-cli が
# 必要で redis-tools を入れていたが、CI ではシャードごとに image を作り直す
# ので apt の実行回数がシャード数だけ増える。実際に `apt-get update` がミラー
# 待ちで止まり、1 シャードだけ 20 分を超えた (#2609)。FLUSHDB は引数なしの
# 単一コマンドなので、fixtures/rate_limit.ts が RESP を直接書いて依存を消した。

WORKDIR /work

# package.json と package-lock.json を先 copy して node_modules を image に
# 焼く。spec / config は volume mount で渡すので image rebuild なしで反復
# できる (cypress runner と同 pattern)。
# lockfile は repo に commit 済み。npm ci は lockfile と package.json の
# 不一致を検出して落ちるので、version drift が CI で即座に顕在化する
# (npm install だと黙って解決してしまう)。
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# ENTRYPOINT に npx を使うと global npx cache に playwright を再 install し
# /work/node_modules を見落とすので、image 内の local binary を直接呼ぶ。
ENTRYPOINT ["./node_modules/.bin/playwright"]
CMD ["test"]
